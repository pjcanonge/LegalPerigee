# LegalPerigee Environment Configuration
# Copy this file to .env and fill in your values

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override default models
# ORCHESTRATOR_MODEL=claude-opus-4-8
# RESEARCHER_MODEL=claude-sonnet-4-6

# CourtListener API token — increases rate limits significantly (free at courtlistener.com/help/api/)
# COURTLISTENER_API_TOKEN=your-token-here

# Descrybe Legal Engine MCP URL — enables authority-ranked case law search
# Without this, the system falls back to CourtListener-only mode (still fully functional)
# Contact Descrybe (descrybe.ai) for your MCP endpoint URL
# DESCRYBE_MCP_URL=https://your-descrybe-mcp-endpoint
